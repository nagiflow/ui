{
  "name": "@nagiflow/ui",
  "version": "0.1.0",
  "description": "nagiflow design system: Tailwind v4 + Radix components and production-ready page blocks for Next.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "default": "./dist/blocks/index.js"
    },
    "./illustrations": {
      "types": "./dist/illustrations/index.d.ts",
      "default": "./dist/illustrations/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4",
    "next": ">=15"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}